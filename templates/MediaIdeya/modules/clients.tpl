<section class="mi-clients" id="clients" aria-label="Клиенты" data-aos="clients" data-clients-scroll>
	<div class="mi-clients__track">
		<div class="mi-clients__pin">
			<div class="mi-clients__inner">
				<header class="mi-clients__head">
					<h2 class="mi-clients__title mi-reveal">Нам доверяют</h2>
					<p class="mi-clients__sub mi-reveal mi-reveal--delay">Компании, с которыми мы уже строили результат</p>
				</header>

				<div class="mi-clients__box">
					<div class="mi-clients__fade mi-clients__fade--top" aria-hidden="true"></div>

					<div class="mi-clients__logos" data-clients-logos aria-hidden="true">
						{custom category="5" template="modules/client-logo" limit="30" order="date" sort="asc" cache="no"}
					</div>

					<div class="mi-clients__fade mi-clients__fade--bottom" aria-hidden="true"></div>
				</div>
			</div>
		</div>
	</div>
</section>
