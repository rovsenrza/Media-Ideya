<article class="mi-service-card">
	<div class="mi-service-card__shell">
		<div class="mi-service-card__body">
			<h3 class="mi-service-card__title">{title}</h3>
			<div class="mi-service-card__content">
				<div class="mi-service-card__text">{short-story}</div>
				<div class="mi-service-card__details">{full-story}</div>
				<a class="mi-btn mi-btn--icon" href="{full-link}">
					Узнать подробнее
					<img class="mi-btn__icon" src="{THEME}/images/icons/arrow-up-right.svg" alt="" width="24" height="24" decoding="async">
				</a>
			</div>
		</div>
		<span class="mi-service-card__count" aria-hidden="true"></span>
		<div class="mi-service-card__media">
			[xfgiven_service_image]
			<picture>
				<img src="[xfvalue_image_url_service_image]" alt="{title}" width="860" height="740" decoding="async" loading="lazy">
			</picture>
			[/xfgiven_service_image]
		</div>
	</div>
</article>
