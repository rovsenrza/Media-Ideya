<nav class="mi-breadcrumbs" aria-label="Хлебные крошки">
	<a href="{THEME}/../../">Главная</a>
	<span aria-hidden="true">/</span>
	[xfgiven_contact_title]<span>[xfvalue_contact_title]</span>[/xfgiven_contact_title]
</nav>

<div class="mi-contact-intro__body">
	[xfgiven_contact_title]<h1 class="mi-contact-intro__title" id="mi-contact-title">[xfvalue_contact_title]</h1>[/xfgiven_contact_title]
	<div class="mi-contact-intro__details">
		[xfgiven_footer_phone]
		<div class="mi-contact-detail mi-contact-detail--phone">
			<span class="mi-contact-detail__label">Телефон</span>
			<a class="mi-contact-detail__value" href="tel:[xfvalue_footer_phone_link]">[xfvalue_footer_phone]</a>
		</div>
		[/xfgiven_footer_phone]
		[xfgiven_footer_email]
		<div class="mi-contact-detail mi-contact-detail--mail">
			<span class="mi-contact-detail__label">Почта</span>
			<a class="mi-contact-detail__value mi-contact-detail__value--mail" href="mailto:[xfvalue_footer_email]">[xfvalue_footer_email]</a>
		</div>
		[/xfgiven_footer_email]
		<div class="mi-contact-detail mi-contact-detail--social">
			<span class="mi-contact-detail__label">Соц.сети</span>
			<div class="mi-contact-detail__social-links">
				<img src="{THEME}/images/pages/contact/socials.svg" width="266" height="78" alt="" decoding="async">
				[xfgiven_contact_telegram_url]<a class="mi-contact-detail__social-link mi-contact-detail__social-link--telegram" href="[xfvalue_contact_telegram_url]" aria-label="Telegram" rel="noopener noreferrer"></a>[/xfgiven_contact_telegram_url]
				[xfgiven_contact_whatsapp_url]<a class="mi-contact-detail__social-link mi-contact-detail__social-link--whatsapp" href="[xfvalue_contact_whatsapp_url]" aria-label="WhatsApp" rel="noopener noreferrer"></a>[/xfgiven_contact_whatsapp_url]
			</div>
		</div>
	</div>
	<img class="mi-contact-intro__wreath" src="{THEME}/images/pages/contact/wreath.png" width="630" height="556" alt="" decoding="async">
</div>
