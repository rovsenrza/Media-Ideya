<div class="mi-contact-intro__details">
	<div class="mi-contact-detail">
		<span class="mi-contact-detail__label">Телефон</span>
		<a class="mi-contact-detail__value" href="tel:[xfvalue_footer_phone_link]">[xfvalue_footer_phone]</a>
	</div>
	<div class="mi-contact-detail">
		<span class="mi-contact-detail__label">Почта</span>
		<a class="mi-contact-detail__value mi-contact-detail__value--mail" href="mailto:[xfvalue_footer_email]">[xfvalue_footer_email]</a>
	</div>
	<div class="mi-contact-detail mi-contact-detail--social">
		<span class="mi-contact-detail__label">Соц.сети</span>
		<img src="{THEME}/images/pages/contact/socials.svg" width="266" height="78" alt="" decoding="async">
	</div>
</div>
