<section class="mi-cases-page" aria-label="{title}">
	<article class="mi-case-dialog" role="dialog" aria-modal="true" aria-labelledby="mi-case-title">
		<a class="mi-case-dialog__close" href="{THEME}/../../" aria-label="Закрыть кейс" data-case-close>
			<img src="{THEME}/images/pages/cases/close.svg" width="36" height="36" alt="">
		</a>

		<div class="mi-case-dialog__media">
			[xfgiven_case_hero]
			<div class="mi-case-dialog__cover">
				[xfgiven_case_hero_alt]<img src="[xfvalue_image_url_case_hero]" width="1443" height="915" alt="[xfvalue_case_hero_alt]" decoding="async" fetchpriority="high">[/xfgiven_case_hero_alt]
				[xfnotgiven_case_hero_alt]<img src="[xfvalue_image_url_case_hero]" width="1443" height="915" alt="{title}" decoding="async" fetchpriority="high">[/xfnotgiven_case_hero_alt]
			</div>
			<img class="mi-case-dialog__dots" src="{THEME}/images/pages/cases/slider-dots.svg" width="80" height="8" alt="" decoding="async">
			[/xfgiven_case_hero]
		</div>

		<div class="mi-case-dialog__content" data-case-scroll tabindex="0">
			<header class="mi-case-dialog__header">
				[xfgiven_case_brand]<p class="mi-case-dialog__brand">[xfvalue_case_brand]</p>[/xfgiven_case_brand]
				<h1 id="mi-case-title">{title}</h1>
			</header>

			[xfgiven_case_flow_title]
			<section class="mi-case-section">
				<h2>[xfvalue_case_flow_title]</h2>
				<ol class="mi-case-flow" aria-label="Путь участника">
					[xfgiven_case_flow_1]<li>[xfvalue_case_flow_1]</li>[/xfgiven_case_flow_1]
					[xfgiven_case_flow_2]<li>[xfvalue_case_flow_2]</li>[/xfgiven_case_flow_2]
					[xfgiven_case_flow_3]<li>[xfvalue_case_flow_3]</li>[/xfgiven_case_flow_3]
					[xfgiven_case_flow_4]<li>[xfvalue_case_flow_4]</li>[/xfgiven_case_flow_4]
					[xfgiven_case_flow_5]<li>[xfvalue_case_flow_5]</li>[/xfgiven_case_flow_5]
					[xfgiven_case_flow_6]<li>[xfvalue_case_flow_6]</li>[/xfgiven_case_flow_6]
				</ol>
			</section>
			[/xfgiven_case_flow_title]

			[xfgiven_case_participant_title]
			<section class="mi-case-section mi-case-section--participant">
				<h2>[xfvalue_case_participant_title]</h2>
				[xfgiven_case_participant_intro]<p>[xfvalue_case_participant_intro]</p>[/xfgiven_case_participant_intro]
				<ul class="mi-case-bullets">
					[xfgiven_case_participant_item_1]<li>[xfvalue_case_participant_item_1]</li>[/xfgiven_case_participant_item_1]
					[xfgiven_case_participant_item_2]<li>[xfvalue_case_participant_item_2]</li>[/xfgiven_case_participant_item_2]
				</ul>
			</section>
			[/xfgiven_case_participant_title]

			[xfgiven_case_presentation_title]
			<section class="mi-case-section mi-case-section--presentation">
				<h2>[xfvalue_case_presentation_title]</h2>
				[xfgiven_case_presentation_p_1]<p>[xfvalue_case_presentation_p_1]</p>[/xfgiven_case_presentation_p_1]
				[xfgiven_case_presentation_p_2]<p>[xfvalue_case_presentation_p_2]</p>[/xfgiven_case_presentation_p_2]
			</section>
			[/xfgiven_case_presentation_title]

			[xfgiven_case_results_title]
			<section class="mi-case-section mi-case-section--results">
				<h2>[xfvalue_case_results_title]</h2>
				<ol class="mi-case-results">
					[xfgiven_case_result_1_title]
					<li>
						<span class="mi-case-results__number" aria-hidden="true"><img src="{THEME}/images/pages/cases/wreath-left.svg" alt=""><b></b><img src="{THEME}/images/pages/cases/wreath-right.svg" alt=""></span>
						<span><strong>[xfvalue_case_result_1_title]</strong>[xfgiven_case_result_1_text]<small>[xfvalue_case_result_1_text]</small>[/xfgiven_case_result_1_text]</span>
					</li>
					[/xfgiven_case_result_1_title]
					[xfgiven_case_result_2_title]
					<li>
						<span class="mi-case-results__number" aria-hidden="true"><img src="{THEME}/images/pages/cases/wreath-left.svg" alt=""><b></b><img src="{THEME}/images/pages/cases/wreath-right.svg" alt=""></span>
						<span><strong>[xfvalue_case_result_2_title]</strong>[xfgiven_case_result_2_text]<small>[xfvalue_case_result_2_text]</small>[/xfgiven_case_result_2_text]</span>
					</li>
					[/xfgiven_case_result_2_title]
					[xfgiven_case_result_3_title]
					<li>
						<span class="mi-case-results__number" aria-hidden="true"><img src="{THEME}/images/pages/cases/wreath-left.svg" alt=""><b></b><img src="{THEME}/images/pages/cases/wreath-right.svg" alt=""></span>
						<span><strong>[xfvalue_case_result_3_title]</strong>[xfgiven_case_result_3_text]<small>[xfvalue_case_result_3_text]</small>[/xfgiven_case_result_3_text]</span>
					</li>
					[/xfgiven_case_result_3_title]
					[xfgiven_case_result_4_title]
					<li>
						<span class="mi-case-results__number" aria-hidden="true"><img src="{THEME}/images/pages/cases/wreath-left.svg" alt=""><b></b><img src="{THEME}/images/pages/cases/wreath-right.svg" alt=""></span>
						<span><strong>[xfvalue_case_result_4_title]</strong>[xfgiven_case_result_4_text]<small>[xfvalue_case_result_4_text]</small>[/xfgiven_case_result_4_text]</span>
					</li>
					[/xfgiven_case_result_4_title]
					[xfgiven_case_result_5_title]
					<li>
						<span class="mi-case-results__number" aria-hidden="true"><img src="{THEME}/images/pages/cases/wreath-left.svg" alt=""><b></b><img src="{THEME}/images/pages/cases/wreath-right.svg" alt=""></span>
						<span><strong>[xfvalue_case_result_5_title]</strong>[xfgiven_case_result_5_text]<small>[xfvalue_case_result_5_text]</small>[/xfgiven_case_result_5_text]</span>
					</li>
					[/xfgiven_case_result_5_title]
				</ol>
			</section>
			[/xfgiven_case_results_title]

			[xfgiven_case_cta_title]
			<aside class="mi-case-cta">
				<div class="mi-case-cta__copy">
					<h2>[xfvalue_case_cta_title]</h2>
					[xfgiven_case_cta_text]<p>[xfvalue_case_cta_text]</p>[/xfgiven_case_cta_text]
					<a class="mi-btn" href="{THEME}/../../index.php?do=feedback">Придумать механику для вашего бренда</a>
				</div>
				<img src="{THEME}/images/pages/cases/head.png" width="260" height="395" alt="" loading="lazy" decoding="async">
			</aside>
			[/xfgiven_case_cta_title]
		</div>
	</article>
</section>
