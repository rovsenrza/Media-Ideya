<article class="mi-case-index-card">
	<a class="mi-case-index-card__link" href="{full-link}" data-case-open aria-label="Смотреть кейс: {title}">
		[xfgiven_case_hero]<img src="[xfvalue_image_url_case_hero]" width="680" height="400" loading="lazy" decoding="async" alt="[xfvalue_case_hero_alt]">[/xfgiven_case_hero]
		<span class="mi-case-index-card__body">
			[xfgiven_case_brand]<span>[xfvalue_case_brand]</span>[/xfgiven_case_brand]
			<strong>{title}</strong>
			<em>Смотреть кейс</em>
		</span>
	</a>
</article>
