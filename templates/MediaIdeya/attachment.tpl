[allow-download]
<span class="attachment">
    {{Download file}}: <a href="{link}">{name}</a> [count] [{size}] ({{downloads}}: {count})[/count]
    [allow-online]<br>{{See the file online}}: <a data-highslide="file" data-type="iframe" href="{online-view-link}" target="_blank">{name}</a>[/allow-online]
</span>
[/allow-download]
[not-allow-download]<span class="attachment">{{You do not haveaccess to download files from our server}}</span>[/not-allow-download]