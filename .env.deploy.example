# Copy to .env.deploy and fill in (file is gitignored)
FTP_HOST=ftp.jeywastudio.com
FTP_USER=rovsenrza@jeywastudio.com
FTP_PASS=your_password
FTP_PORT=21
# Subdomain FTP (rovsenrza) — chroot to docroot → .
FTP_REMOTE_DIR=.

SITE_URL=https://mediaideya.jeywastudio.com/
SITE_ICON_PATH=templates/MediaIdeya/images/media-ideya-logo.png

# Hosting MySQL (cPanel → MySQL Databases). Leave empty to upload local dbconfig as-is.
